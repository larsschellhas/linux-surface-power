[Unit]
Description=Surface power management (SMF blob interpreter)
Documentation=https://github.com/larsschellhas/linux-surface-power
# thermald changes package PL1 itself and would fight the daemon (FR-S6). Conflicts= alone does not order the two: without After=
# the daemon can start while thermald is still stopping, refuses to run ("thermald is running") and, after a failover to
# thermald through the OnFailure= line below, never comes back (seen 18.11.2026, 25 min without the controller).
After=systemd-modules-load.service thermald.service surface-gpu-clockd.socket
# The dGPU stand-in sends its clock cap to the helper; without it only the stand-in is off (spec dgpu-standin-service 6).
Wants=surface-gpu-clockd.socket
Conflicts=thermald.service
StartLimitIntervalSec=600
StartLimitBurst=3
# Optional fallback when the daemon fails for good (not enabled by default, spec supervisor 8):
# OnFailure=thermald.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/surface-powerd
ExecStopPost=/usr/bin/surface-power-reset
# Above the kernel's 20 s limit for freezing tasks before suspend, during which the daemon may not run.
WatchdogSec=30
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
RuntimeDirectory=surface-power
RuntimeDirectoryMode=0755
# The snapshot must survive a crash so that the successor and the reset tool know the firmware values.
RuntimeDirectoryPreserve=yes
StateDirectory=surface-power
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
# DAC_OVERRIDE for powercap and the SSAM cdev; SYS_RAWIO for PL3 in MSR 0x615 (spec outputs 4). Remove SYS_RAWIO to keep PL3
# log-only. The thermal actions (spec outputs 7) call systemctl, which talks to PID 1 over its local socket as root.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_RAWIO
MemoryMax=100M
# Under system-wide memory pressure (swap thrashing) the loop stalled for more than the watchdog's 30 s and was killed (18.11.2026):
# keep the daemon out of swap and protect its pages from reclaim. Its peak is about 22 MB.
MemorySwapMax=0
MemoryLow=64M
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
