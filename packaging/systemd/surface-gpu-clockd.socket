# Socket of the clock helper: root only; the helper checks the peer as well (spec dgpu-standin-service 5.2).
[Unit]
Description=Socket of the Surface dGPU clock cap helper
Documentation=https://github.com/larsschellhas/linux-surface-power

[Socket]
ListenStream=/run/surface-gpu-clock/sock
SocketUser=root
SocketMode=0600
DirectoryMode=0755

[Install]
WantedBy=sockets.target
